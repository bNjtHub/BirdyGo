<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- FORK: BirdyGo launch colors and mark match Flutter startup (J6c). -->
    <!-- Android 12+ uses the padded BirdyGo mark in both system themes. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <!-- FORK: light system controls on the Encre launch background. -->
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/birdygo_launch_background</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:navigationBarColor">@color/birdygo_launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/birdygo_launch_background</item>
        <!-- FORK: no mark here, the Flutter splash fades the bird in on the same Encre. -->
        <item name="android:windowSplashScreenAnimatedIcon">@android:color/transparent</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/birdygo_launch_background</item>
    </style>
</resources>
